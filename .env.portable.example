# Portable production mode: set this to true only after the Google OAuth
# redirect URIs, owner email, and database values below are ready.
PORTABLE_AUTH_ENABLED=true
# This client-visible flag only enables the portable interface policy; it contains
# no secret and hides raw-file upload because this deployment intentionally has no R2.
VITE_PORTABLE_AUTH_ENABLED=true
PORTABLE_APP_BASE_URL=https://your-project.vercel.app
OWNER_GOOGLE_EMAIL=you@example.com

# User-owned Google OAuth web client. Never prefix server secrets with VITE_.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
OWNER_SESSION_SECRET=replace-with-a-random-32-plus-character-secret
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-distinct-random-32-plus-character-secret

# User-owned Gemini key. Keep this server-only; never prefix it with VITE_.
# The owner selected Gemini's Free Tier and accepts its applicable data-use terms.
GEMINI_API_KEY=your-gemini-api-key

# MySQL-compatible TiDB Cloud connection string with TLS enabled.
DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}

# No object-storage variables are required for the privacy-first portable path.
# Keep original resume files and downloaded exports in your own Google Drive or
# local files. The app stores only the approved resume text in TiDB and creates
# DOCX/PDF exports and draft-only Gmail attachments when requested.

# Do not set these Manus-only values in an external deployment.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
