# Portable production mode: set this to true only after the Google OAuth
# redirect URIs, owner email, database, and storage values below are ready.
PORTABLE_AUTH_ENABLED=true
PORTABLE_APP_BASE_URL=https://your-project.vercel.app
OWNER_GOOGLE_EMAIL=you@example.com

# User-owned Google OAuth web client. Never prefix server secrets with VITE_.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
OWNER_SESSION_SECRET=replace-with-a-random-32-plus-character-secret
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-distinct-random-32-plus-character-secret

# MySQL-compatible TiDB Cloud connection string with TLS enabled.
DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}

# Cloudflare R2 (or any S3-compatible provider) for uploaded source files.
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=job-automation-private
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Do not set these Manus-only values in an external deployment.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
